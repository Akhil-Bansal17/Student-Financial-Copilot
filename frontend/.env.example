# Production API URL pointing to the deployed FastAPI backend (e.g. Render, Railway, Fly.io, or VPS)
# When set, apiClient routes all requests directly to this URL.
# In local development, leave empty or set to http://localhost:8000 to use Vite proxy.
VITE_API_URL=https://your-backend-api.onrender.com
# Alternatively:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
