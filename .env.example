# =============================================================================
# Student Financial Copilot - Environment Configuration Template
# Copy this file to .env and adjust variables for your local environment.
# =============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME="Student Financial Copilot"
DEBUG=True

# Security
# Generate a secure secret key for production (e.g. openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://copilot_user:copilot_secret@localhost:5432/student_financial_copilot

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend Vite API Base URL (used during client builds/dev)
VITE_API_BASE_URL=http://localhost:8000

# AI Financial Copilot (Phase 7)
# Provider options: "gemini" (default), "openai", or "mock" (for offline/testing)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=15

# Bank Synchronization & Account Aggregator (AA) Sandbox (Phase 9A & 9B)
# Legitimate RBI Account Aggregator FIU integration (Setu AA Sandbox)
# Provider options: "mock_bank" (default, deterministic sandbox), "setu_aa" (Setu Account Aggregator)
BANK_PROVIDER=mock_bank
AA_PROVIDER=setu_aa
AA_BASE_URL=https://fiu-sandbox.setu.co
AA_CLIENT_ID=your_sandbox_client_id
AA_CLIENT_SECRET=your_sandbox_client_secret
AA_PRODUCT_INSTANCE_ID=your_sandbox_product_instance_id
AA_WEBHOOK_SECRET=your_sandbox_webhook_secret
AA_REDIRECT_URL=http://localhost:5173/connected-accounts
AA_TIMEOUT_SECONDS=15
# Automatic Background Sync & Reconciliation (Phase 10)
BANK_SYNC_ENABLED=True
BANK_SYNC_INTERVAL_MINUTES=15
BANK_SYNC_LOCK_TIMEOUT_SECONDS=300
BANK_SYNC_MAX_RETRIES=3
BANK_SYNC_LOOKBACK_DAYS=30
